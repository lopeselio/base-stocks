{
  "name": "@base-stocks/mcp",
  "version": "0.0.1",
  "description": "MCP server giving AI agents read access to Coinbase tokenized stocks (B20) and StockBaskets on Base",
  "license": "MIT",
  "type": "module",
  "bin": {
    "base-stocks-mcp": "./dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "start": "node dist/index.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "pnpm build && pnpm test"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "viem": "^2.57.16",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@base-stocks/sdk": "workspace:^",
    "@types/node": "^22",
    "tsup": "^9.0.0",
